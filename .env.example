# PostgreSQL connection. Leave empty to use the embedded PGlite database in ./data/pglite (demo / local dev).
DATABASE_URL=

# Optional: Claude answers to student questions (otherwise: offline answers from approved lesson material)
ANTHROPIC_API_KEY=
AI_TEACHER_MODEL=claude-opus-5-5

# Optional: neural server-side voice (Azure AI Speech, has natural Uzbek voices uz-UZ-SardorNeural / uz-UZ-MadinaNeural)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Where uploaded lesson files are stored (local disk adapter)
UPLOAD_DIR=./data/uploads

# Set to "false" to disable creating demo institutions/users on an empty database
SEED_DEMO_DATA=true

# Key for encrypting MFA (TOTP) secrets at rest. REQUIRED in production (any long random string).
APP_SECRET=

# Require two-step login (TOTP) for Super Admin and institution admins
REQUIRE_MFA_FOR_ADMINS=false
